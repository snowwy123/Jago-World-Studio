{
  "format": "jago-world-project",
  "version": 1,
  "id": "6a450097-f75c-4e31-b579-ba41550a2bf2",
  "name": "The Lantern Coast",
  "genre": "Fantasy",
  "description": "Three island communities keep watch over a sea that returns lost things. Their lights are beginning to fail.",
  "premise": "What do we owe the things we thought were gone?",
  "tone": "Warm, salt-worn, quietly uncanny",
  "calendar": "Coast year",
  "notes": "An original fictional example made for this studio. Follow the links, move a map marker, or change the world completely.",
  "entries": [
    {
      "id": "456441a5-f155-47d7-94a7-b1e06f3d738c",
      "type": "Character",
      "name": "Mara Vale",
      "summary": "A young keeper who has inherited a lighthouse and a debt nobody will explain.",
      "body": "Mara tends the western beacon above [[Lantern Harbour]]. She knows how to repair its glass, but not why its flame turns blue when the tide is high.\n\n## The turning point\nA boat arrives carrying her father’s handwriting. Her father vanished twelve years ago.",
      "secret": "The light sometimes speaks in her own voice.",
      "status": "Canon",
      "tags": [],
      "fields": {
        "Desire": "Find the truth without leaving the harbour unprotected.",
        "Fear": "Learning that the light is keeping someone imprisoned.",
        "Strength": "",
        "Flaw": "",
        "Appearance": "",
        "Voice": "",
        "Arc": "From protecting a tradition to choosing which parts deserve to survive."
      },
      "references": [],
      "created": 1791404036645,
      "updated": 1791404036645
    },
    {
      "id": "2dc8b549-87fc-4c72-ae1a-4ea4e4739f3f",
      "type": "Place",
      "name": "Lantern Harbour",
      "summary": "A crowded port of low roofs, tide stairs and windows facing the western beacon.",
      "body": "The harbour trades with [[Reedwake]] and [[High Cairn]]. At low tide, children collect blue glass from the exposed road.\n\n## A contested memory\nThe guild says the first beacon saved the coast. Fisher families say it changed the sea.",
      "secret": "",
      "status": "Canon",
      "tags": [],
      "fields": {
        "Landscape": "",
        "Population": "",
        "Government": "",
        "Trade": "",
        "Atmosphere": "",
        "A secret": ""
      },
      "references": [],
