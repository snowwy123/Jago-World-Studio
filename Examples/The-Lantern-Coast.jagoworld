      "id": "69248acb-0a6c-4371-8df7-8d639632da4c",
      "type": "Magic / science",
      "name": "The Returning Tide",
      "summary": "The sea returns lost objects, but never quite as they were.",
      "body": "",
      "secret": "",
      "status": "Canon",
      "tags": [],
      "fields": {
        "Rules": "An object returns only when someone still remembers it.",
