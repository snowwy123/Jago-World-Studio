  "documents": [
    {
      "id": "19a223c7-cf23-4522-984b-c00fbe4c40a2",
      "name": "World premise",
      "kind": "Reference",
      "status": "Draft",
      "body": "What do we owe the things we thought were gone?\n\n## The world in motion\nThe beacons connect three communities. The returning tide makes memory an economic resource.",
      "links": [
        "2dc8b549-87fc-4c72-ae1a-4ea4e4739f3f"
      ],
      "order": 0
    },
    {
      "id": "b7254350-b8a5-4d1b-a439-a824d16e8c95",
      "name": "A letter from the tide",
      "kind": "Scene",
      "status": "Draft",
      "body": "Mara finds a sealed letter at the foot of the beacon. Its paper is dry. Its date is tomorrow.\n\n## Scene question\nWill she show it to the guild or read it alone?",
      "links": [
        "456441a5-f155-47d7-94a7-b1e06f3d738c",
        "2dc8b549-87fc-4c72-ae1a-4ea4e4739f3f"
      ],
      "goal": "Make Mara choose who she trusts.",
      "conflict": "The guild claims every returned object.",
      "order": 1
    }
  ],
